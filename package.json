{
  "name": "c-drive-cleaner",
  "productName": "Roberta",
  "version": "0.1.0",
  "private": true,
  "description": "C 盘空间分析仪表盘（umi/max + antd5，Figma Dark 风格）",
  "main": "electron/main.js",
  "scripts": {
    "dev": "max dev",
    "build": "max build",
    "postinstall": "max setup",
    "setup": "max setup",
    "tsc": "tsc --noEmit",
    "server": "node server/index.js",
    "test": "node --test \"server/tests/*.test.js\" \"electron/*.test.js\"",
    "migrate": "node scripts/migrate-data.js",
    "electron": "electron .",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npm run build && electron-builder --win --publish never",
    "electron:build-run": "scripts\\build-run.bat",
    "electron:release": "scripts\\build-release.bat"
  },
  "dependencies": {},
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@umijs/max": "^4.3.29",
    "antd": "^5.21.6",
    "concurrently": "^9.1.0",
    "dayjs": "^1.11.23",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4"
  }
}
